{
  "name": "vibechat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-db.js && next build",
    "build:render": "node scripts/prepare-db.js && next build",
    "start": "node scripts/prepare-db.js && tsx server.ts",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "tsx tests/smoke.test.ts",
    "server": "tsx server.ts",
    "clean": "powershell -Command \"Get-Process node -ErrorAction SilentlyContinue | Stop-Process -Force; Remove-Item -Recurse -Force .\\\\node_modules; Remove-Item -Recurse -Force .\\\\.next; Remove-Item -Recurse -Force .\\\\prisma\\\\client; npm ci\"",
    "postinstall": "prisma generate",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "upgrade": "npm install -g npm-check-updates && ncu -u && npm install"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.441.0",
    "next": "14.2.15",
    "prisma": "^5.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^2.5.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12"
  }
}
