# Environment variables for VibeChat

# Database Connection (SQLite for zero-config local dev, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Authentication Secret for JWT Tokens
AUTH_SECRET="vibechat_super_secure_jwt_secret_key_2025_999!"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Real-Time WebSocket Server URL
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_PORT="3001"

# AI Service Configuration (Optional: server uses rich fallback intelligent engine if empty)
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Cloud Media Storage (Optional: defaults to simulated fast high-fidelity local/data-uri storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Peer-to-Peer Payments (Sandbox / Development Mode active by default)
RAZORPAY_KEY_ID="rzp_test_vibechat_demo"
RAZORPAY_KEY_SECRET="demo_secret_key_vibechat"
STRIPE_SECRET_KEY="sk_test_vibechat_demo"
STRIPE_WEBHOOK_SECRET="whsec_demo_vibechat"
